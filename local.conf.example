# Copy to ~/.config/desktop-mate-linux/local.conf or to local.conf next to
# launch.sh. All settings are optional.

# Frame cap below the game's own 60 FPS, for example 30 to save power.
#DM_FPS=30

# Click-through shape sampling period in ms (GE-Proton 11-7 and newer).
#DM_SHAPE_INTERVAL=200

# Use another Proton build than the one selected in Steam.
#DM_PROTON="$HOME/.local/share/Steam/compatibilitytools.d/Proton-GE Latest"

# Keep the click-through flag on the game window (default 1). Needed with
# GE-Proton 11-7 and newer, or the character cannot attach to windows.
#DM_GAME_TRANSPARENT=0

# With a GE-Proton from tools/build-ge-proton.sh: copy every frame through an
# offscreen window like stock GE-Proton does (default 1, draw directly).
#DM_DIRECT=0

# Write Unity's own log to /dev/shm/ghost-bridge/unity.log (the game turns it off).
#DM_UNITY_LOG=1

# Extra Unity player arguments. The default limits Unity to two job worker
# threads; with one per CPU thread the idle ones spin and cost CPU under Wine.
#DM_UNITY_ARGS="-job-worker-count 2"

# Do not add the Linux section to the game's settings page.
#DM_HOOK=0

# Start the game without the window bridge.
#DM_NO_BRIDGE=1
